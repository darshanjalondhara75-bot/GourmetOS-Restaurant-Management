# ==========================================
# GOURMET OS - BACKEND ENVIRONMENT EXAMPLE
# ==========================================

# Server Configuration
PORT=8000
HOST=127.0.0.1
APP_TITLE="GourmetOS Restaurant Management API"
APP_VERSION="2.0.0"

# MongoDB Database Configuration
MONGO_URL="mongodb://127.0.0.1:27017/"
DATABASE_NAME="restaurant_db"

# JWT Security Configuration
SECRET_KEY="YOUR_SECRET_JWT_KEY_HERE"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_SECONDS=60
REFRESH_TOKEN_EXPIRE_DAYS=365

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Public URL used when generating table QR codes (do not use localhost in production)
PUBLIC_APP_URL=http://localhost:3000

# Razorpay online order payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Conversion used when menu prices are in USD and Razorpay charges in INR
USD_TO_INR_RATE=83.00
