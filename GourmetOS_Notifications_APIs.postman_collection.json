            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Shift Timing Update\",\n  \"message\": \"Evening shift will start at 04:30 PM today.\",\n  \"type\": \"shift\",\n  \"target_role\": \"all\"\n}"
