        },
        {
          "name": "Delete Shift (Triggers Notification)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:8000/api/shifts/shf_1725196000",
              "protocol": "http",
