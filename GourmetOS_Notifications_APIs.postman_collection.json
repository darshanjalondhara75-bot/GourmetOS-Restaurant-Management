              "mode": "raw",
              "raw": "{\n  \"status\": \"Cooking\"\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/orders/ORD-1725197000000/status",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "orders", "ORD-1725197000000", "status"]
            }
