    {
      "name": "🕒 3. Shift Management (Auto-Triggers Shift Notifications)",
      "item": [
        {
          "name": "Create Shift (Triggers Shift Notification)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shift_name\": \"Morning Shift\",\n  \"start_time\": \"08:00 AM\",\n  \"end_time\": \"04:00 PM\",\n  \"assigned_user\": \"Chef Alex\",\n  \"status\": \"Active\"\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/shifts",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "shifts"]
            }
          }
        },
        {
          "name": "Assign Staff to Shift (Triggers Notification)",
          "request": {
            "method": "PATCH",
