  "item": [
    {
      "name": "🔐 1. Authentication",
      "item": [
        {
          "name": "Login as Admin (Get Bearer Token)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gourmet.com\",\n  \"password\": \"adminpassword\",\n  \"requested_role\": \"admin\"\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/auth/login",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
