{
  "info": {
    "_postman_id": "gourmetos-notifications-apis-collection",
    "name": "GourmetOS - Notifications, Order & Shift APIs",
    "description": "Complete Postman collection for GourmetOS Notifications, Shift Notifications, and Order Notifications",
