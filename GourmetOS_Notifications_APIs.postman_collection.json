            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"table_number\": \"3\",\n  \"customer_name\": \"John Doe\",\n  \"items\": [\n    {\n      \"item_id\": \"itm_001\",\n      \"name\": \"Truffle Pasta\",\n      \"quantity\": 2,\n      \"price\": 18.5,\n      \"notes\": \"Extra parmesan cheese\"\n    }\n  ],\n  \"special_instructions\": \"Serve beverages first.\"\n}"
            },
            "url": {
              "raw": "http://127.0.0.1:8000/api/orders",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "orders"]
            }
