          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:8000/api/shifts/shf_1725196000/status?status=Closed",
              "protocol": "http",
              "host": ["127", "0", "0", "1"],
              "port": "8000",
              "path": ["api", "shifts", "shf_1725196000", "status"],
              "query": [{ "key": "status", "value": "Closed" }]
